# このファイルをコピーして .env を作成し、実際の値を設定してください（cp .env.example .env）。
# .env はコミットしないでください（.gitignore 済み）。

# ローカルDB（.devcontainer/compose.yaml の db サービスが env_file 経由で読み込む）
MYSQL_ROOT_PASSWORD=rootroot
MYSQL_DATABASE=stamprally
MYSQL_USER=gantaro
MYSQL_PASSWORD=stamprally_dev_pass

# devcontainerのホストポート割当（複数ワークツリーを同時に開く場合はここを変更する）
DB_HOST_PORT=3307
APP_HOST_PORT=8099

# DB接続（MYSQL_* を変更したら DATABASE_URL も合わせて変更してください）
DATABASE_URL=mysql://gantaro:stamprally_dev_pass@db:3306/stamprally

# LINE Messaging API（LINE Developersコンソールで発行）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LIFF（QRコードスキャン用アプリのLIFF ID）
LIFF_ID=

# 管理者ログイン用パスワード（平文で置かず、必要に応じてハッシュ化した値を運用で管理する）
ADMIN_PASSWORD=
