# このファイルをコピーして .env を作成し、実際の値を設定してください（cp .env.example .env）。
# .env はコミットしないでください（.gitignore 済み）。

# DB接続（.devcontainer/compose.yaml のdbサービス設定と一致させること）
DATABASE_URL=mysql://gantaro:stamprally_dev_pass@db:3306/stamprally

# LINE Messaging API（LINE Developersコンソールで発行）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LIFF（QRコードスキャン用アプリのLIFF ID）
LIFF_ID=

# 管理者ログイン用パスワード（平文で置かず、必要に応じてハッシュ化した値を運用で管理する）
ADMIN_PASSWORD=
