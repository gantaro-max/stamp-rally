# このファイルをコピーして .env を作成し、実際の値を設定してください（cp .env.example .env）。
# .env はコミットしないでください（.gitignore 済み）。

# ローカルDB（.devcontainer/compose.yaml の db サービスが env_file 経由で読み込む）
MYSQL_ROOT_PASSWORD=rootroot
MYSQL_DATABASE=stamprally
MYSQL_USER=gantaro
MYSQL_PASSWORD=stamprally_dev_pass

# devcontainerのホストポート割当（複数ワークツリーを同時に開く場合はここを変更する）
DB_HOST_PORT=3307
APP_HOST_PORT=8099

# DB接続（MYSQL_* を変更したら DATABASE_URL も合わせて変更してください）
DATABASE_URL=mysql://gantaro:stamprally_dev_pass@db:3306/stamprally

# LINE Messaging API（LINE Developersコンソールで発行）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 画像URL等を組み立てる際に前置する公開ベースURL（末尾スラッシュなし）
PUBLIC_BASE_URL=http://localhost:8000

# LIFF（QRコードスキャン用アプリのLIFF ID）
LIFF_ID=

# LIFFのIDトークン検証（POST https://api.line.me/oauth2/v2.1/verify の client_id）に使う、
# LIFFアプリが属するチャネルのID
LINE_LOGIN_CHANNEL_ID=

# LINE公式アカウントマネージャー（manager.line.biz）で発行される「友だち追加URL」
# （例: https://lin.ee/xxxxx）。ダッシュボードの友だち追加QRコードに使う。
# 未設定でもアプリは起動する（LINE公式アカウント発行前でも他の機能を動かせるようにするため）
LINE_ADD_FRIEND_URL=

# 管理者ログイン用パスワード（平文で置かず、必要に応じてハッシュ化した値を運用で管理する）
# ローカル開発環境専用の共通値。本番（Koyeb）の ADMIN_PASSWORD とは別物なので、
# この値を本番環境で使い回さないこと。
ADMIN_PASSWORD=stamprally_dev_admin_pass
